API_HOST=localhost
API_PORT=8000
API_URL=http://${API_HOST}:${API_PORT}/api
WS_URL=ws://${API_HOST}:${API_PORT}

FRONTEND_HOST=localhost
FRONTEND_PORT=4300
FRONTEND_URL=http://${FRONTEND_HOST}:${FRONTEND_PORT}

# if you are not using docker, change this to localhost
POSTGRES_HOST = db

POSTGRES_USER=tapiz_user
POSTGRES_PASSWORD=tapiz_password
POSTGRES_DB = tapiz

 # Docker db public port
POSTGRES_PORT_HOST = 5432

# Session cookies are Secure when API_URL is https. Set to true/false to override.
# The frontend and API must be on the same site (ports or subdomains may differ).
SESSION_COOKIE_SECURE=

# Client IPs (used by rate limits) come from X-Forwarded-For only when set.
# Use a hop count (1 behind nginx) or the proxy IP/CIDR, and only when the API
# port is reachable through the proxy alone; otherwise the header can be spoofed.
TRUST_PROXY=

# Where uploaded images are stored (default: ./uploads)
UPLOADS_DIR=

# Log password reset and email verification links when they can't be emailed
# (always on with NODE_ENV=development)
AUTH_LOG_RESET_LINKS=false

# Local-development AI screenshot login using a personal API token.
# The route is unavailable unless NODE_ENV=development.
AI_AGENT_LOGIN_ENABLED=false

# SMTP configuration for notification, password reset and verification emails.
# Without SMTP users can't reset their password or verify their email.
# Replace with your SMTP server credentials
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Optional from address
SMTP_FROM=""
SMTP_SECURE=false
