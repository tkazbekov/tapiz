server_tokens off;

# Trust the external HTTPS scheme only from the explicitly configured connector.
map "$realip_remote_addr:$http_x_forwarded_proto" $effective_scheme {
    default $scheme;
    "${TRUSTED_PROXY_IP}:https" https;
}

server {
    listen 80 default_server;
    charset utf-8;
    client_max_body_size 10M;
    large_client_header_buffers 4 32k;
    set_real_ip_from ${TRUSTED_PROXY_IP};
    real_ip_header CF-Connecting-IP;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https: wss:" always;
    }
    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $effective_scheme;
        proxy_redirect off;
    }
    location /socket.io/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $effective_scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
