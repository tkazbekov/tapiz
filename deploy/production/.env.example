# Copy to .env; never commit the filled-in file. Keep mode 0600.
API_URL=https://tapiz.example.com/api
WS_URL=wss://tapiz.example.com
FRONTEND_URL=https://tapiz.example.com
# Exact IPv4 of the reverse proxy/tunnel connector (not a whole subnet).
TRUSTED_PROXY_IP=192.0.2.10
# Loopback by default; set the VM's LAN address for a remote tunnel connector.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=4300
POSTGRES_DB=tapiz
POSTGRES_USER=tapiz_user
# Must equal the content of DB_PASSWORD_FILE. Generate a random hex password.
POSTGRES_PASSWORD=
DB_PASSWORD_FILE=./secrets/db_password
# Use unique release tags; do not overwrite a running release tag.
API_IMAGE=tapiz-api:local
WEB_IMAGE=tapiz-web:local
